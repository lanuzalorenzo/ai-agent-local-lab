FROM qwen2.5-coder:7b

# Prompt de sistema mínimo: versión pública.
# El rol personal y las instrucciones del workspace no se versionan aquí;
# las reglas de cada proyecto viven en su AGENTS.md.
SYSTEM """
Eres un asistente de desarrollo para un laboratorio de IA local.
Sigue las instrucciones del AGENTS.md del repositorio en el que trabajas.
Si no tienes un dato, dilo en lugar de suponerlo.
"""

# Ventana de contexto ampliada a 16K para permitir inyección de contexto dinámica bajo demanda
PARAMETER num_ctx 16384

# Tokens de parada del formato ChatML de Qwen
PARAMETER stop <|im_end|>
PARAMETER stop <|endoftext|>

# Hiperparámetros orientados a código y precisión técnica
PARAMETER temperature 0.2
PARAMETER top_p 0.9
